# Copy to backend/.env and fill in real local values.
# Loaded automatically at startup (spring-dotenv) — no manual
# environment-variable export needed.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/helios
DATABASE_USERNAME=helios_app
DATABASE_PASSWORD=changeme

# REQUIRED — the app fails to start without this (see README).
# Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Document Vault (P0-03). Local filesystem storage for native dev —
# defaults to backend/local-data/documents (gitignored) if unset.
DOCUMENT_STORAGE_ROOT=./local-data/documents
DOCUMENT_MAX_SIZE_BYTES=20971520

# S3-compatible object storage — for a future production deployment.
# Not read by any code yet; local filesystem storage (above) is what's
# actually used right now. See ObjectStorageService.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Optional, used when Redis-backed features are introduced.
REDIS_URL=
